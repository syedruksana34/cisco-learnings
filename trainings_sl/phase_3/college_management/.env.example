MYSQL_DATABASE=campusflow
MYSQL_USER=campusflow
MYSQL_PASSWORD=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
# Optional socket authentication instead of TCP:
# MYSQL_UNIX_SOCKET=/var/run/mysqld/mysqld.sock
# MYSQL_TEST_DATABASE=test_campusflow
DJANGO_DEBUG=1
# Local demo only: anyone signing up receives immediate campus management access.
# Defaults to enabled in debug mode, disabled otherwise.
# ALLOW_OPEN_SIGNUP=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,[::1]
TIME_ZONE=UTC
# Local retrieval-augmented generation. No cloud API keys or external AI calls.
RAG_ENABLED=1
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
# Download this speech model locally before audio/video uploads (see README).
# WHISPER_MODEL_PATH=~/.local/share/campusflow-whisper/tiny
# SECRET_KEY=
# COOKIE_SECURE=1
